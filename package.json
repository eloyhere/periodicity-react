{
    "name": "periodicity-react",
    "version": "0.1.11",
    "description": "Material-inspired React components, layouts, data views, and design-system providers.",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/periodicity-react.js",
    "module": "./dist/periodicity-react.js",
    "types": "./dist/types/library.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/library.d.ts",
            "import": "./dist/periodicity-react.js"
        },
        "./styles.css": "./dist/periodicity-react.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "README.zh-CN.md",
        "CHANGELOG.md",
        "CHANGELOG.zh-CN.md"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/eloyhere/periodicity-react.git"
    },
    "homepage": "https://github.com/eloyhere/periodicity-react#readme",
    "bugs": {
        "url": "https://github.com/eloyhere/periodicity-react/issues"
    },
    "keywords": [
        "react",
        "material",
        "design-system",
        "components",
        "typescript"
    ],
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run build:lib",
        "build:app": "tsc -b && vite build",
        "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/prepare-types.cjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "audit:contrast": "node scripts/audit-contrast.cjs",
        "audit:locales": "node scripts/audit-locales.cjs",
        "test:a11y": "vitest run tests/a11y.test.tsx",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "preview": "vite preview",
        "prepublishOnly": "npm run build:lib"
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/language": "^6.13.1",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "codemirror": "^6.0.2"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@eslint/js": "^10.0.1",
        "@rolldown/plugin-babel": "^0.2.4",
        "@testing-library/react": "^16.3.3",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "axe-core": "^4.14.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
