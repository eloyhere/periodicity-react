{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
        "noEmit": false,
        "emitDeclarationOnly": true,
        "declaration": true,
        "declarationMap": true,
        "outDir": "./dist/types",
        "rootDir": "./src",
        "allowImportingTsExtensions": false
    },
    "include": ["src"],
    "exclude": ["src/showcase", "src/main.tsx", "src/App.tsx", "src/structure", "src/task"]
}
